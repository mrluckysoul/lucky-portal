# Copy to .env and fill in. Everything is optional for local testing:
# without SMTP/Twilio the OTP is printed in the server console and shown in the UI.

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=10
COOKIE_SECURE=false           # set true when serving over https

# ---- Email OTP (any SMTP provider: Gmail app password, Brevo, SendGrid, Mailgun...) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Lucky Portal <you@gmail.com>

# ---- SMS OTP to the user's mobile (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# or use a messaging service instead of a from number
TWILIO_MESSAGING_SERVICE_SID=

# ---- Real Google sign-in (leave empty to use the demo Google button) ----
GOOGLE_CLIENT_ID=

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
